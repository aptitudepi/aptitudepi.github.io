.wrangler

# Generated by tools/build.mjs — artifact-only deploy; never committed
resume.html
cv.html
man/

# Generated by tools/build-blog.mjs — artifact-only deploy; never committed
# (root-scoped: assets/blog/ + images/blog/ stay committable post-image dirs)
/blog/

# Generated by the Pagefind post-build step (npm run build:pagefind) — search
# bundle served from /pagefind/, rebuilt every deploy; never committed.
/pagefind/

# Generated by tools/build-pdf.mjs
assets/resume.pdf
assets/cv.pdf
.build/

# Generated by tools/sitemap.mjs in CI
sitemap.xml

# CI deploys write build-info.json (.github/workflows/static.yml); local
# previews generate it from git (last-commit date) — never committed either way.
build-info.json


# Full-CV content checkout used by the CI build
full-cv/

# Local-only artifacts — never committed (bun.lock is canonical; npm is not
# the toolchain, session tooling dirs and stray dumps stay out of the tree)
node_modules/
package-lock.json
.codegraph/
.opencode/
/log

# Folder-action inbox + media-push tmp — workstation-only, never committed
# (patterns only; the default ~/Pictures/Blog-Inbox lives outside the repo)
.done/
Blog-Inbox/
Inbox/
media-push-*

# Draft post images — image binaries stay local, never committed (media-push
# writes .jpg/.jpeg/.png next to the draft .md; the .md itself is still tracked)
# gitignore has no brace expansion, so the three extensions are listed
posts/_drafts/*.jpeg
posts/_drafts/*.jpg
posts/_drafts/*.png
