{
  "name": "aptitudepi.github.io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "snapshot": "node tools/snapshot-terminal.mjs",
    "check:budgets": "node tools/check-budgets.mjs",
    "assert:registry": "node tools/assert-registry.mjs",
    "build:blog": "node tools/build-blog.mjs",
    "build:pagefind": "pagefind --site . --glob 'blog/**/*.html'",
    "assert:rss": "node tools/assert-rss.mjs",
    "new-post": "node tools/new-post.mjs",
    "preview": "BUILD_DRAFTS=1 node tools/build-blog.mjs && python3 -m http.server 8000",
    "preview:prod": "node tools/build-blog.mjs && python3 -m http.server 8000"
  },
  "dependencies": {
    "marked": "15.0.12",
    "@11ty/gray-matter": "2.0.2",
    "shiki": "4.5.0",
    "sharp": "0.35.5",
    "pagefind": "1.5.2"
  }
}
